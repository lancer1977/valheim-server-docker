#!/bin/bash
# valheim-plus-updater is being called by
# valheim-updater when $VALHEIM_PLUS=true
# It downloads the ValheimPlus mod and merges
# the downloaded archive with the vanilla
# Valheim server into /opt/valheim/plus

# Include defaults and common functions
. /usr/local/etc/valheim/defaults
. /usr/local/etc/valheim/common


fetch_github_api() {
    local url="$1"
    local max_attempts=5
    local attempt=1
    local delay=1
    local http_code
    local body_file
    local -a curl_args=(-sSL -w '%{http_code}')

    # Build Authorization header if GITHUB_TOKEN is set
    if [ -n "${GITHUB_TOKEN:-}" ]; then
        curl_args+=(-H "Authorization: token $GITHUB_TOKEN")
        # debug() writes to stdout (see logstd in common), and this whole
        # function's stdout is captured by the caller via command
        # substitution as the API response body. Without redirecting to
        # stderr, this log line lands in front of the real JSON and breaks
        # every downstream jq parse.
        debug "Using GitHub API authentication with token" >&2
    fi

    body_file=$(mktemp) || { error "Failed to create temp file for GitHub API response"; return 1; }
    # shellcheck disable=SC2064
    trap "rm -f '$body_file'" RETURN

    while [ "$attempt" -le "$max_attempts" ]; do
        debug "Fetching GitHub API (attempt $attempt/$max_attempts): $url" >&2

        # Write the response body straight to a file and capture only the
        # status code on stdout, so there is no fragile split of a combined
        # curl -w stream (that split previously broke on some curl builds
        # and fed truncated/garbled JSON to jq downstream).
        http_code=$(curl "${curl_args[@]}" -o "$body_file" "$url")

        if [ "$http_code" = "200" ]; then
            cat "$body_file"
            return 0
        elif [ "$http_code" = "403" ]; then
            # Rate limit or permission error - retry with backoff
            error "GitHub API returned 403 (rate limited or forbidden) on attempt $attempt/$max_attempts"
            if [ "$attempt" -lt "$max_attempts" ]; then
                debug "Retrying in ${delay}s (exponential backoff)" >&2
                sleep "$delay"
                delay=$((delay * 2))
            fi
        else
            # Other HTTP error
            error "GitHub API returned HTTP $http_code on attempt $attempt"
            if [ "$attempt" -lt "$max_attempts" ]; then
                debug "Retrying in ${delay}s (exponential backoff)" >&2
                sleep "$delay"
                delay=$((delay * 2))
            fi
        fi

        attempt=$((attempt + 1))
    done

    # All retries exhausted
    error "Failed to fetch GitHub API after $max_attempts attempts"
    return 1
}


main() {
    local api_response
    local download_url
    local remote_updated_at

    api_response=$(fetch_github_api "https://api.github.com/repos/$VALHEIM_PLUS_REPO/releases/$VALHEIM_PLUS_RELEASE") \
        || fatal "Error: could not retrieve ValheimPlus release info from Github API"
    api_response=$(jq -r ".assets[] | select(.name == \"$vp_zipfile\")" <<< "$api_response" )
    download_url=$(jq -r  ".browser_download_url" <<< "$api_response" )
    remote_updated_at=$(jq -r  ".updated_at" <<< "$api_response" )

    check_for_mod_update \
        "$download_url" \
        "$remote_updated_at" \
        "$vp_zipfile" \
        "$vp_mergefile" \
        "$vp_download_path" \
        "$vp_config_path" \
        "extracted" \
        "$vp_install_path" \
        "ValheimPlus"
}


main
